{
  "mcpServers": {
    "aikido": {
      "command": "npx",
      "args": [
        "-y",
        "@aikidosec/mcp@latest"
      ],
      "transport": "stdio",
      "lifecycle": "eager"
    },
    "context7": {
      "transport": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "lifecycle": "eager"
    },
    "gh_grep": {
      "transport": "streamable-http",
      "url": "https://mcp.grep.app",
      "lifecycle": "eager"
    },
    "websearch": {
      "transport": "streamable-http",
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "eager"
    },
    "linear": {
      "transport": "streamable-http",
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "eager"
    },
    "protege": {
      "transport": "streamable-http",
      "url": "https://mcp-internal.withprotege.ai/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "notion": {
      "transport": "streamable-http",
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "protocolVersion": "auto",
      "lifecycle": "lazy"
    },
    "chrome": {
      "command": "mcp-chrome-stdio",
      "args": [],
      "transport": "stdio",
      "lifecycle": "lazy"
    },
    "protege-local": {
      "transport": "streamable-http",
      "url": "http://localhost:3002/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "Neon": {
      "url": "https://mcp.neon.tech/mcp"
    }
  }
}
