{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "protege-local": {
      "type": "remote",
      "url": "http://localhost:3002/mcp",
      "oauth": {}
    },
    "protege": {
      "type": "remote",
      "url": "https://mcp-internal.withprotege.ai/mcp",
      "oauth": {}
    },
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "node",
        "/opt/homebrew/lib/node_modules/mcp-chrome-bridge/dist/mcp/mcp-server-stdio.js"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "ollama-ai-provider-v2",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/api"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen 3.6 35B (local)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "options": {
            "think": false
          }
        },
        "gemma4:latest": {
          "name": "Gemma 4 (local)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:OMLX_API_KEY}"
      },
      "models": {
        "gemma-4-26B-A4B-it-qat-4bit": {
          "name": "Gemma 4 26B A4B (oMLX)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "gpt-oss-20b-MXFP4-Q8": {
          "name": "GPT-OSS 20B (oMLX)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "Qwen3-Coder-30B-A3B-Instruct-4bit-dwq-v2": {
          "name": "Qwen3 Coder 30B DWQ (oMLX)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-antigravity-auth@latest",
    "oh-my-openagent@latest"
  ],
  "disabled_providers": [
    "omlx"
  ],
  "model": "anthropic/claude-sonnet-4-6"
}
